def save_verified_figure(fig: mpl.figure.Figure, output_path: Path, dpi: int = 300) -> None:
    """Save a PNG atomically and verify that its compressed stream is complete."""
    from PIL import Image

    temporary_path = output_path.with_name(f"{output_path.stem}.tmp{output_path.suffix}")
    fig.canvas.draw()
    fig.savefig(temporary_path, dpi=dpi, bbox_inches="tight", facecolor="white")
    plt.close(fig)
    with Image.open(temporary_path) as image:
        image.verify()
    os.replace(temporary_path, output_path)
    gc.collect()


