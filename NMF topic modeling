def save_focus_result(result: FocusResult, output_dir: Path, letter: str, args: argparse.Namespace) -> None:
    focus_dir = output_dir / f"focus_{letter}"
    focus_dir.mkdir(parents=True, exist_ok=True)
    keep_assignment_columns = [
        column
        for column in [
            args.id_column,
            args.year_column,
            args.title_column,
            args.focus_column,
            args.evidence_column,
            "Topic_ID",
            "Topic_Label",
            "Topic_Score",
            "Map_1",
            "Map_2",
            "_source_row",
        ]
        if column in result.assignments.columns
    ]
    result.assignments[keep_assignment_columns].to_csv(focus_dir / "topic_assignments.csv", index=False)
    result.topic_summary.to_csv(focus_dir / "topic_summary.csv", index=False)
    result.annual_prevalence.to_csv(focus_dir / "annual_topic_prevalence.csv", index=False)
    result.representative_papers.to_csv(focus_dir / "representative_papers.csv", index=False)
    with open(focus_dir / "quality_metrics.json", "w", encoding="utf-8") as handle:
        json.dump(result.quality, handle, ensure_ascii=False, indent=2, default=str)


def main() -> int:
    args = parse_args()
    if args.write_default_lexicon:
        destination = Path(args.write_default_lexicon)
        destination.parent.mkdir(parents=True, exist_ok=True)
        with open(destination, "w", encoding="utf-8") as handle:
            json.dump(DEFAULT_TECHNOLOGY_LEXICON, handle, ensure_ascii=False, indent=2)
        print(f"Wrote default lexicon: {destination}")
        return 0

    if not args.input:
        raise ValueError("--input is required unless --write-default-lexicon is used")

    input_path = resolve_input_path(args.input)
    args.input = str(input_path)
    output_dir = Path(args.output_dir).expanduser() if args.output_dir else input_path.parent / "ipsc_topic_results"
    output_dir.mkdir(parents=True, exist_ok=True)
    configure_plot_style()
    df = load_data(args)
    topic_overrides = parse_topic_overrides(args.topics)

    embeddings = None
    if args.method == "bertopic":
        embeddings = load_or_compute_embeddings(df, args)

    results: Dict[str, FocusResult] = {}
    skipped_rows = []
    all_assignments = []
    all_summaries = []
    quality_rows = []

    for focus_value, (letter, focus_name) in FOCUS_MAP.items():
        focus_positions = np.flatnonzero(df[args.focus_column].to_numpy() == focus_value)
        focus_df = df.iloc[focus_positions].copy().reset_index(drop=True)
        if len(focus_df) < args.minimum_focus_size:
            skipped_rows.append(
                {"Focus": letter, "Focus_Name": focus_name, "N": len(focus_df), "Reason": "Below minimum focus size"}
            )
            continue
        print(f"[{letter}] {focus_name}: {len(focus_df)} documents", flush=True)
        if args.method == "nmf":
            n_topics = select_topic_count(letter, len(focus_df), topic_overrides)
            result = fit_nmf_focus(focus_df, args, n_topics)
        else:
            result = fit_bertopic_focus(focus_df, embeddings[focus_positions], args)
        results[letter] = result
        save_focus_result(result, output_dir, letter, args)

        assignments = result.assignments.copy()
        all_assignments.append(assignments)
        summary = result.topic_summary.copy()
        summary.insert(0, "Focus_Name", focus_name)
        summary.insert(0, "Focus", letter)
        all_summaries.append(summary)
        quality_rows.append({"Focus": letter, "Focus_Name": focus_name, **result.quality})

    if not results:
        raise RuntimeError("No focus contained enough records for topic modeling")

    assignments_df = pd.concat(all_assignments, ignore_index=True)
    summaries_df = pd.concat(all_summaries, ignore_index=True)
    assignments_df.to_csv(output_dir / "all_topic_assignments.csv", index=False)
    summaries_df.to_csv(output_dir / "all_topic_summaries.csv", index=False)
    pd.DataFrame(quality_rows).to_csv(output_dir / "topic_quality_metrics.csv", index=False)
    pd.DataFrame(skipped_rows).to_csv(output_dir / "skipped_focuses.csv", index=False)

    lexicon = load_lexicon(args.lexicon_json)
    lexicon_matches, long_matches = apply_technology_lexicon(df, lexicon, args)
    prevalence = compute_dictionary_prevalence(df, long_matches, args)
    match_columns = [
        column
        for column in [args.id_column, args.year_column, args.title_column, args.focus_column, "Technology_Matches", "_source_row"]
        if column in lexicon_matches.columns
    ]
    lexicon_matches[match_columns].to_csv(output_dir / "technology_dictionary_matches.csv", index=False)
    long_matches.to_csv(output_dir / "technology_dictionary_matches_long.csv", index=False)
    prevalence.to_csv(output_dir / "technology_dictionary_prevalence.csv", index=False)
    with open(output_dir / "technology_lexicon_used.json", "w", encoding="utf-8") as handle:
        json.dump(lexicon, handle, ensure_ascii=False, indent=2)

    plot_topic_rivers(results, output_dir / "topic_rivers_by_focus.png", args)
    if not prevalence.empty:
        plot_dictionary_rivers(prevalence, output_dir / "dictionary_technology_rivers.png", args)
    plot_evidence_heatmap(assignments_df, output_dir / "topic_evidence_heatmap.png", args)
    plot_appendix_topic_maps(
        results,
        output_dir / "appendix_semantic_maps_by_topic.png",
        args,
        color_by="topic",
    )
    plot_appendix_topic_maps(
        results,
        output_dir / "appendix_semantic_maps_by_evidence.png",
        args,
        color_by="evidence",
    )

    run_metadata = {
        "Input": str(Path(args.input).resolve()),
        "Method": args.method,
        "N_eligible_records": len(df),
        "Focuses_modeled": sorted(results),
        "Focuses_skipped": skipped_rows,
        "Random_state": args.random_state,
        "Stream_baseline": args.stream_baseline,
        "Appendix_map": args.appendix_map,
        "Rolling_window": args.rolling_window,
        "Interpretation": "Ribbon width is annual topic prevalence, not product-cohort attrition.",
    }
    with open(output_dir / "run_metadata.json", "w", encoding="utf-8") as handle:
        json.dump(run_metadata, handle, ensure_ascii=False, indent=2)

    print(f"Completed. Outputs: {output_dir.resolve()}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise
