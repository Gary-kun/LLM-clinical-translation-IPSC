def resolve_input_path(raw_path: str) -> Path:
    """Resolve omitted extensions and common Chinese/ASCII parenthesis variants."""
    path = Path(raw_path).expanduser()
    candidates: List[Path] = [path]

    if path.suffix.lower() not in {".xlsx", ".xls", ".csv"}:
        candidates.extend(path.with_suffix(extension) for extension in (".xlsx", ".xls", ".csv"))

    # The supplied filename ends with an ASCII right parenthesis. Also try the
    # visually similar full-width Chinese right parenthesis used by Windows files.
    raw_text = str(path)
    if raw_text.endswith(")"):
        chinese_close = Path(raw_text[:-1] + "）")
        candidates.append(chinese_close)
        if chinese_close.suffix.lower() not in {".xlsx", ".xls", ".csv"}:
            candidates.extend(
                chinese_close.with_suffix(extension) for extension in (".xlsx", ".xls", ".csv")
            )

    for candidate in candidates:
        if candidate.is_file():
            return candidate.resolve()

    # Final fallback: find a unique Excel/CSV file beginning with the supplied
    # workbook prefix in the intended directory.
    parent = path.parent
    if parent.is_dir():
        prefix = path.name.split("（", 1)[0].split("(", 1)[0]
        matches = sorted(
            candidate
            for candidate in parent.glob(f"{prefix}*")
            if candidate.is_file() and candidate.suffix.lower() in {".xlsx", ".xls", ".csv"}
        )
        if len(matches) == 1:
            return matches[0].resolve()
        if len(matches) > 1:
            names = "\n  - ".join(str(candidate) for candidate in matches)
            raise FileNotFoundError(
                "More than one matching workbook was found. Pass the exact file using --input:\n  - "
                + names
            )

    tried = "\n  - ".join(str(candidate) for candidate in candidates)
    raise FileNotFoundError(
        "Input workbook was not found. Confirm the F: drive is mounted and the filename is correct. "
        "Paths tried:\n  - " + tried
    )


def load_data(args: argparse.Namespace) -> pd.DataFrame:
    path = Path(args.input)
    if path.suffix.lower() in {".xlsx", ".xls"}:
        sheet = int(args.sheet) if str(args.sheet).isdigit() else args.sheet
        df = pd.read_excel(path, sheet_name=sheet)
    elif path.suffix.lower() == ".csv":
        df = pd.read_csv(path)
    else:
        raise ValueError("Input must be .xlsx, .xls, or .csv")

    required = [args.title_column, args.abstract_column, args.year_column, args.focus_column]
    missing = [column for column in required if column not in df.columns]
    if missing:
        raise KeyError(f"Missing required columns: {missing}")

    df = df.copy()
    df["_source_row"] = np.arange(len(df))
    if args.therapeutic_column in df.columns:
        yes = df[args.therapeutic_column].astype(str).str.strip().str.upper().eq("YES")
        df = df.loc[yes].copy()

    df[args.year_column] = pd.to_numeric(df[args.year_column], errors="coerce")
    df = df.dropna(subset=[args.year_column, args.focus_column]).copy()
    df[args.year_column] = df[args.year_column].astype(int)
    if args.min_year is not None:
        df = df.loc[df[args.year_column] >= args.min_year].copy()
    if args.max_year is not None:
        df = df.loc[df[args.year_column] <= args.max_year].copy()

    title = df[args.title_column].fillna("").astype(str).str.strip()
    abstract = df[args.abstract_column].fillna("").astype(str).str.strip()
    df["_document"] = (title + ". " + abstract).str.replace(r"\s+", " ", regex=True).str.strip()
    df = df.loc[df["_document"].str.len() >= 30].copy()
    df["_focus_letter"] = df[args.focus_column].map(lambda x: FOCUS_MAP.get(x, ("Other", str(x)))[0])
    df["_focus_name"] = df[args.focus_column].map(lambda x: FOCUS_MAP.get(x, ("Other", str(x)))[1])
    return df.reset_index(drop=True)


def parse_topic_overrides(text: Optional[str]) -> Dict[str, int]:
    result = dict(DEFAULT_TOPIC_COUNTS)
    if not text:
        return result
    for item in text.split(","):
        key, value = item.split("=", 1)
        result[key.strip().upper()] = int(value)
    return result


def safe_slug(text: str) -> str:
    return re.sub(r"[^A-Za-z0-9]+", "_", text).strip("_").lower()


def select_topic_count(letter: str, n_documents: int, overrides: Mapping[str, int]) -> int:
    requested = overrides.get(letter, max(3, round(math.sqrt(n_documents / 2))))
    maximum = max(2, n_documents // 15)
    return max(2, min(requested, maximum))


def make_stopwords() -> List[str]:
    return sorted(set(ENGLISH_STOP_WORDS).union(GENERIC_STOPWORDS))


def label_from_terms(terms: Sequence[str], n: int = 4) -> str:
    cleaned = [term.replace("_", " ") for term in terms if term]
    return " / ".join(cleaned[:n])


def project_documents_2d(features, args: argparse.Namespace) -> Tuple[Optional[np.ndarray], str]:
    """Create appendix coordinates using UMAP when available, otherwise t-SNE."""
    if args.appendix_map == "none":
        return None, "none"

    method = args.appendix_map
    if method in {"auto", "umap"}:
        try:
            from umap import UMAP

            reducer = UMAP(
                n_neighbors=min(30, max(10, round(math.sqrt(features.shape[0])))),
                n_components=2,
                min_dist=0.20,
                metric="cosine",
                random_state=args.random_state,
            )
            return np.asarray(reducer.fit_transform(features)), "UMAP"
        except ImportError:
            if method == "umap":
                raise ImportError("--appendix-map umap requires umap-learn")

    # t-SNE is applied after a deterministic SVD compression for speed and
    # denoising. It is a visualization only and is never used to fit topics.
    n_components = min(50, features.shape[0] - 1, features.shape[1] - 1)
    if n_components >= 2:
        reduced = TruncatedSVD(
            n_components=n_components,
            random_state=args.random_state,
        ).fit_transform(features)
    else:
        reduced = np.asarray(features)
    perplexity = min(30.0, max(5.0, (len(reduced) - 1) / 5))
    coordinates = TSNE(
        n_components=2,
        perplexity=perplexity,
        init="pca",
        learning_rate="auto",
        max_iter=1000,
        random_state=args.random_state,
    ).fit_transform(reduced)
    return np.asarray(coordinates), "t-SNE"


def fit_nmf_focus(
    focus_df: pd.DataFrame,
    args: argparse.Namespace,
    n_topics: int,
) -> FocusResult:
    documents = focus_df["_document"].tolist()
    min_df = 2 if len(documents) < 300 else 3
    vectorizer = TfidfVectorizer(
        lowercase=True,
        stop_words=make_stopwords(),
        ngram_range=(1, 3),
        min_df=min_df,
        max_df=0.90,
        max_features=30000,
        sublinear_tf=True,
        strip_accents="unicode",
    )
    matrix = vectorizer.fit_transform(documents)
    if matrix.shape[1] < n_topics:
        raise ValueError(f"Only {matrix.shape[1]} usable terms for {n_topics} topics")

    model = NMF(
        n_components=n_topics,
        init="nndsvda",
        solver="cd",
        beta_loss="frobenius",
        max_iter=700,
        random_state=args.random_state,
        l1_ratio=0.05,
    )
    weights = model.fit_transform(matrix)
    weights = normalize(weights, norm="l1", axis=1)
    components = model.components_
    terms = np.asarray(vectorizer.get_feature_names_out())

    topic_terms: Dict[int, List[str]] = {}
    topic_labels: Dict[int, str] = {}
    for topic_id in range(n_topics):
        indices = components[topic_id].argsort()[::-1][: args.top_terms]
        words = terms[indices].tolist()
        topic_terms[topic_id] = words
        topic_labels[topic_id] = label_from_terms(words)

    hard_topic = weights.argmax(axis=1)
    hard_score = weights.max(axis=1)
    assignments = focus_df.copy()
    assignments["Topic_ID"] = hard_topic
    assignments["Topic_Label"] = [topic_labels[value] for value in hard_topic]
    assignments["Topic_Score"] = hard_score
    coordinates, map_method = project_documents_2d(matrix, args)
    if coordinates is not None:
        assignments["Map_1"] = coordinates[:, 0]
        assignments["Map_2"] = coordinates[:, 1]

    topic_summary_rows = []
    representative_rows = []
    for topic_id in range(n_topics):
        selected = np.flatnonzero(hard_topic == topic_id)
        topic_summary_rows.append(
            {
                "Topic_ID": topic_id,
                "Topic_Label": topic_labels[topic_id],
                "Top_Terms": "; ".join(topic_terms[topic_id]),
                "Hard_Assignment_N": int(len(selected)),
                "Mean_Topic_Weight": float(weights[:, topic_id].mean()),
            }
        )
        best = np.argsort(weights[:, topic_id])[::-1][: args.representative_papers]
        for rank, local_index in enumerate(best, start=1):
            row = focus_df.iloc[local_index]
            representative_rows.append(
                {
                    "Topic_ID": topic_id,
                    "Topic_Label": topic_labels[topic_id],
                    "Rank": rank,
                    "Topic_Weight": float(weights[local_index, topic_id]),
                    "ID": row.get(args.id_column, row["_source_row"]),
                    "Year": row[args.year_column],
                    "Title": row[args.title_column],
                }
            )

    years = np.arange(focus_df[args.year_column].min(), focus_df[args.year_column].max() + 1)
    prevalence = pd.DataFrame(index=years)
    for topic_id in range(n_topics):
        weighted = pd.Series(weights[:, topic_id], index=focus_df.index)
        by_year = weighted.groupby(focus_df[args.year_column]).sum()
        prevalence[topic_labels[topic_id]] = by_year.reindex(years, fill_value=0).to_numpy()
    prevalence = prevalence.div(prevalence.sum(axis=1).replace(0, np.nan), axis=0).fillna(0)
    prevalence.index.name = "Year"

    quality: Dict[str, object] = {
        "Method": "NMF",
        "N_documents": len(focus_df),
        "N_topics": n_topics,
        "Vocabulary_size": matrix.shape[1],
        "Reconstruction_error": float(model.reconstruction_err_),
        "Appendix_map_method": map_method,
    }
    if n_topics > 1 and len(focus_df) > n_topics:
        sample_size = min(len(focus_df), 2000)
        rng = np.random.default_rng(args.random_state)
        sample = rng.choice(len(focus_df), size=sample_size, replace=False)
        try:
            quality["Silhouette_cosine"] = float(
                silhouette_score(matrix[sample], hard_topic[sample], metric="cosine")
            )
        except ValueError:
            quality["Silhouette_cosine"] = np.nan

    return FocusResult(
        assignments=assignments,
        topic_summary=pd.DataFrame(topic_summary_rows),
        annual_prevalence=prevalence.reset_index(),
        representative_papers=pd.DataFrame(representative_rows),
        quality=quality,
    )


def load_or_compute_embeddings(df: pd.DataFrame, args: argparse.Namespace) -> np.ndarray:
    if args.embeddings_npy:
        matrix = np.load(args.embeddings_npy)
        # Accept either embeddings for all source rows or for the post-filter dataframe.
        if matrix.shape[0] == len(df):
            return matrix
        max_source_row = int(df["_source_row"].max())
        if matrix.shape[0] > max_source_row:
            return matrix[df["_source_row"].to_numpy()]
        raise ValueError(
            f"Embedding rows ({matrix.shape[0]}) do not align with filtered records ({len(df)}) "
            f"or source rows (max index {max_source_row})."
        )
    try:
        from sentence_transformers import SentenceTransformer
    except ImportError as exc:
        raise ImportError(
            "BERTopic without --embeddings-npy requires sentence-transformers. "
            "Install it or supply a row-aligned .npy embedding matrix."
        ) from exc
    encoder = SentenceTransformer(args.embedding_model)
    return np.asarray(
        encoder.encode(
            df["_document"].tolist(),
            batch_size=32,
            show_progress_bar=True,
            normalize_embeddings=True,
        )
    )


