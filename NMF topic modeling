    try:
        from bertopic import BERTopic
        from bertopic.vectorizers import ClassTfidfTransformer
        from hdbscan import HDBSCAN
        from sklearn.feature_extraction.text import CountVectorizer
        from umap import UMAP
    except ImportError as exc:
        raise ImportError(
            "BERTopic mode requires bertopic, umap-learn and hdbscan. "
            "Install the optional dependencies or use --method nmf."
        ) from exc

    n_documents = len(focus_df)
    min_cluster_size = min(40, max(10, round(n_documents * 0.025)))
    n_neighbors = min(30, max(10, round(math.sqrt(n_documents))))
    vectorizer = CountVectorizer(
        stop_words=make_stopwords(),
        ngram_range=(1, 3),
        min_df=2 if n_documents < 300 else 3,
        max_df=0.90,
    )
    umap_model = UMAP(
        n_neighbors=n_neighbors,
        n_components=8,
        min_dist=0.0,
        metric="cosine",
        random_state=args.random_state,
    )
    hdbscan_model = HDBSCAN(
        min_cluster_size=min_cluster_size,
        min_samples=max(5, min_cluster_size // 2),
        metric="euclidean",
        cluster_selection_method="eom",
        prediction_data=True,
    )
    topic_model = BERTopic(
        embedding_model=None,
        umap_model=umap_model,
        hdbscan_model=hdbscan_model,
        vectorizer_model=vectorizer,
        ctfidf_model=ClassTfidfTransformer(reduce_frequent_words=True),
        calculate_probabilities=False,
        verbose=True,
    )
    documents = focus_df["_document"].tolist()
    topics, probabilities = topic_model.fit_transform(documents, focus_embeddings)
    topics = np.asarray(topics)
    probabilities = np.asarray(probabilities) if probabilities is not None else np.full(len(topics), np.nan)

    unique_topics = sorted(topic for topic in set(topics.tolist()) if topic != -1)
    labels: Dict[int, str] = {}
    terms_by_topic: Dict[int, List[str]] = {}
    for topic_id in unique_topics:
        terms = [word for word, _ in (topic_model.get_topic(topic_id) or [])[: args.top_terms]]
        terms_by_topic[topic_id] = terms
        labels[topic_id] = label_from_terms(terms)
    labels[-1] = "Unclassified"

    assignments = focus_df.copy()
    assignments["Topic_ID"] = topics
    assignments["Topic_Label"] = [labels[value] for value in topics]
    assignments["Topic_Score"] = probabilities if probabilities.ndim == 1 else np.nanmax(probabilities, axis=1)
    coordinates, map_method = project_documents_2d(focus_embeddings, args)
    if coordinates is not None:
        assignments["Map_1"] = coordinates[:, 0]
        assignments["Map_2"] = coordinates[:, 1]

    topic_summary_rows = []
    representative_rows = []
    for topic_id in unique_topics:
        selected = np.flatnonzero(topics == topic_id)
        centroid = focus_embeddings[selected].mean(axis=0)
        centroid /= np.linalg.norm(centroid) + 1e-12
        similarities = focus_embeddings[selected] @ centroid
        best_local = selected[np.argsort(similarities)[::-1][: args.representative_papers]]
        topic_summary_rows.append(
            {
                "Topic_ID": topic_id,
                "Topic_Label": labels[topic_id],
                "Top_Terms": "; ".join(terms_by_topic[topic_id]),
                "Hard_Assignment_N": int(len(selected)),
                "Mean_Topic_Weight": np.nan,
            }
        )
        for rank, local_index in enumerate(best_local, start=1):
            row = focus_df.iloc[local_index]
            representative_rows.append(
                {
                    "Topic_ID": topic_id,
                    "Topic_Label": labels[topic_id],
                    "Rank": rank,
                    "Topic_Weight": float(focus_embeddings[local_index] @ centroid),
                    "ID": row.get(args.id_column, row["_source_row"]),
                    "Year": row[args.year_column],
                    "Title": row[args.title_column],
                }
            )

    years = np.arange(focus_df[args.year_column].min(), focus_df[args.year_column].max() + 1)
    topic_names = [labels[topic] for topic in unique_topics] + ["Unclassified"]
    prevalence = pd.DataFrame(0.0, index=years, columns=topic_names)
    for year in years:
        year_topics = topics[focus_df[args.year_column].to_numpy() == year]
        if len(year_topics) == 0:
            continue
        for topic_id in set(year_topics.tolist()):
            prevalence.loc[year, labels[topic_id]] = np.mean(year_topics == topic_id)
    prevalence.index.name = "Year"

    non_noise = topics != -1
    quality: Dict[str, object] = {
        "Method": "BERTopic",
        "N_documents": n_documents,
        "N_topics": len(unique_topics),
        "Noise_fraction": float(np.mean(~non_noise)),
        "Min_cluster_size": min_cluster_size,
        "N_neighbors": n_neighbors,
        "Appendix_map_method": map_method,
    }
    if non_noise.sum() >= 3 and len(set(topics[non_noise])) >= 2:
        try:
            quality["Silhouette_cosine"] = float(
                silhouette_score(focus_embeddings[non_noise], topics[non_noise], metric="cosine")
            )
        except ValueError:
            quality["Silhouette_cosine"] = np.nan

    return FocusResult(
        assignments=assignments,
        topic_summary=pd.DataFrame(topic_summary_rows),
        annual_prevalence=prevalence.reset_index(),
        representative_papers=pd.DataFrame(representative_rows),
        quality=quality,
    )


def load_lexicon(path: Optional[str]) -> Mapping[str, Sequence[str]]:
    if not path:
        return DEFAULT_TECHNOLOGY_LEXICON
    with open(path, "r", encoding="utf-8") as handle:
        payload = json.load(handle)
    if not isinstance(payload, dict) or not all(isinstance(value, list) for value in payload.values()):
        raise ValueError("Lexicon JSON must be an object mapping labels to lists of regex patterns")
    return payload


def apply_technology_lexicon(
    df: pd.DataFrame,
    lexicon: Mapping[str, Sequence[str]],
    args: argparse.Namespace,
) -> Tuple[pd.DataFrame, pd.DataFrame]:
    matches = df.copy()
    compiled = {
        label: [re.compile(pattern, flags=re.IGNORECASE) for pattern in patterns]
        for label, patterns in lexicon.items()
    }
    documents = matches["_document"].tolist()
    labels_per_document: List[List[str]] = []
    for document in documents:
        labels = [
            label
            for label, patterns in compiled.items()
            if any(pattern.search(document) for pattern in patterns)
        ]
        labels_per_document.append(labels)
    matches["Technology_Matches"] = ["; ".join(labels) for labels in labels_per_document]

    long_rows = []
    for row_position, labels in enumerate(labels_per_document):
        row = matches.iloc[row_position]
        for label in labels:
            long_rows.append(
                {
                    "_source_row": row["_source_row"],
                    "ID": row.get(args.id_column, row["_source_row"]),
                    "Year": row[args.year_column],
                    "Focus": row["_focus_letter"],
                    "Focus_Name": row["_focus_name"],
                    "Technology": label,
                    "Title": row[args.title_column],
                }
            )
    return matches, pd.DataFrame(long_rows)


def compute_dictionary_prevalence(
    df: pd.DataFrame,
    long_matches: pd.DataFrame,
    args: argparse.Namespace,
) -> pd.DataFrame:
    if long_matches.empty:
        return pd.DataFrame(columns=["Focus", "Year", "Technology", "Matched_N", "Focus_Year_N", "Prevalence"])
    denominators = (
        df.groupby(["_focus_letter", args.year_column])
        .size()
        .rename("Focus_Year_N")
        .reset_index()
        .rename(columns={"_focus_letter": "Focus", args.year_column: "Year"})
    )
    counts = (
        long_matches.groupby(["Focus", "Year", "Technology"])
        .size()
        .rename("Matched_N")
        .reset_index()
    )
    result = counts.merge(denominators, on=["Focus", "Year"], how="left")
    result["Prevalence"] = result["Matched_N"] / result["Focus_Year_N"]
    return result


def select_plot_topics(prevalence: pd.DataFrame, max_topics: int) -> pd.DataFrame:
    data = prevalence.set_index("Year").copy()
    totals = data.sum(axis=0).sort_values(ascending=False)
    keep = totals.index[:max_topics].tolist()
    selected = data[keep].copy()
    remaining = [column for column in data.columns if column not in keep]
    if remaining:
        selected["Other topics"] = data[remaining].sum(axis=1)
    selected = selected.div(selected.sum(axis=1).replace(0, np.nan), axis=0).fillna(0)
    return selected


