def plot_evidence_heatmap(
    all_assignments: pd.DataFrame,
    output_path: Path,
    args: argparse.Namespace,
) -> None:
    if args.evidence_column not in all_assignments.columns:
        return
    evidence_order = [
        "E1 - In vitro only",
        "E2 - Small-animal in vivo",
        "E3 - Large-animal in vivo",
        "E4 - Non-human primate",
        "E5 - Human / clinical",
    ]
    topic_order = (
        all_assignments.groupby(["_focus_letter", "Topic_Label"])
        .size()
        .sort_values(ascending=False)
        .reset_index()
    )
    topic_order["Display"] = topic_order["_focus_letter"] + ": " + topic_order["Topic_Label"]
    top = topic_order.groupby("_focus_letter", sort=True).head(5)
    allowed = set(zip(top["_focus_letter"], top["Topic_Label"]))
    selected = all_assignments.loc[
        [(_f, _t) in allowed for _f, _t in zip(all_assignments["_focus_letter"], all_assignments["Topic_Label"])]
    ].copy()
    selected["Display"] = selected["_focus_letter"] + ": " + selected["Topic_Label"]
    table = pd.crosstab(selected["Display"], selected[args.evidence_column])
    table = table.reindex(columns=evidence_order, fill_value=0)
    display_order = top["Display"].tolist()
    table = table.reindex(display_order).fillna(0)
    percentages = table.div(table.sum(axis=1).replace(0, np.nan), axis=0).fillna(0) * 100

    fig_height = max(7, 0.30 * len(percentages) + 2.2)
    fig, axis = plt.subplots(figsize=(10, fig_height))
    image = axis.imshow(percentages.to_numpy(), aspect="auto", cmap="Blues", vmin=0, vmax=100)
    axis.set_xticks(np.arange(5), ["E1\nIn vitro", "E2\nSmall animal", "E3\nLarge animal", "E4\nNHP", "E5\nHuman"])
    axis.set_yticks(np.arange(len(percentages)), percentages.index)
    axis.set_title("Evidence maturity of the most prevalent algorithmic topics", loc="left", fontweight="bold", pad=12)
    for i in range(percentages.shape[0]):
        for j in range(percentages.shape[1]):
            value = percentages.iloc[i, j]
            count = int(table.iloc[i, j])
            text = "—" if count == 0 else f"{value:.0f}%\n({count})"
            axis.text(j, i, text, ha="center", va="center", fontsize=7, color="white" if value > 55 else "#23313D")
    colorbar = fig.colorbar(image, ax=axis, fraction=0.03, pad=0.02)
    colorbar.set_label("Within-topic share (%)")
    for spine in axis.spines.values():
        spine.set_visible(False)
    fig.savefig(output_path, dpi=300, bbox_inches="tight", facecolor="white")
    plt.close(fig)


